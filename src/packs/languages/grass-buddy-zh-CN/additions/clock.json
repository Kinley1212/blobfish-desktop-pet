{
  "category": "clock",
  "phrases": [
    { "id": "grass-clock-prop-in-01", "event": "clock.alarmClockAppeared", "text": "闹钟放手边了。我替你看着。", "weight": 6 },
    { "id": "grass-clock-prop-in-02", "event": "clock.alarmClockAppeared", "text": "时间种下了。到点会响。", "weight": 4 },
    { "id": "grass-clock-prop-in-03", "event": "clock.alarmClockAppeared", "text": "好，闹钟在这里。", "weight": 4 },
    { "id": "grass-clock-prop-in-04", "event": "clock.alarmClockAppeared", "text": "我拿住它。你先做自己的事。", "weight": 3 },

    { "id": "grass-clock-prop-out-01", "event": "clock.alarmClockDisappeared", "text": "闹钟收起来了。", "weight": 6 },
    { "id": "grass-clock-prop-out-02", "event": "clock.alarmClockDisappeared", "text": "手边空出来了。提醒已经处理完。", "weight": 4 },
    { "id": "grass-clock-prop-out-03", "event": "clock.alarmClockDisappeared", "text": "这段时间守完了。", "weight": 4 },
    { "id": "grass-clock-prop-out-04", "event": "clock.alarmClockDisappeared", "text": "不用再盯着它了。", "weight": 3 },

    { "id": "grass-clock-alarm-ring-01", "event": "clock.alarmRinging", "text": "到点了。该动身了。", "weight": 6 },
