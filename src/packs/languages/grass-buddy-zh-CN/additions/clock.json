    { "id": "grass-clock-timer-extend-02", "event": "clock.timerExtended", "text": "时间往后挪了一截。", "weight": 4 },
    { "id": "grass-clock-timer-cancel-01", "event": "clock.timerCancelled", "text": "计时取消。显示器可以收了。", "weight": 5 },
