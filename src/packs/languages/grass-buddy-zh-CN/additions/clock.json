    { "id": "grass-clock-snooze-01", "event": "clock.alertSnoozed", "text": "再等 {minutes} 分钟。我还拿着。", "weight": 5, "conditions": { "requires": ["minutes"] } },
    { "id": "grass-clock-snooze-02", "event": "clock.alertSnoozed", "text": "先缓一会儿。提醒还会回来。", "weight": 4 },
