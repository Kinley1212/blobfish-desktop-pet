    { "id": "grass-clock-alarm-ring-04", "event": "clock.alarmRinging", "text": "提醒送到了。别让它白响。", "weight": 3 },

    { "id": "grass-clock-timer-start-01", "event": "clock.timerStarted", "text": "开始计时。下面会一直显示。", "weight": 5 },
