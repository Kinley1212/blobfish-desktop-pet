{
  "category": "rare",
  "phrases": [
    { "id": "grass-buddy-zh-cn-time0000-01", "event": "rare.time0000", "text": "00:00。日期换了。土不用换。", "weight": 2, "rarity": "rare" },
    { "id": "grass-buddy-zh-cn-time0000-02", "event": "rare.time0000", "text": "四个零。很像四颗还没发芽的种子。", "weight": 2, "rarity": "rare" },
    { "id": "grass-buddy-zh-cn-time0000-03", "event": "rare.time0000", "text": "午夜了。新的一页，我长得还是很旧。", "weight": 2, "rarity": "rare" },
    { "id": "grass-buddy-zh-cn-time0123-01", "event": "rare.time0123", "text": "01:23。一步一步。我还在第一步生根。", "weight": 2, "rarity": "rare" },
    { "id": "grass-buddy-zh-cn-time0123-02", "event": "rare.time0123", "text": "一、二、三。数到这里，已经有进展。", "weight": 2, "rarity": "rare" },
    { "id": "grass-buddy-zh-cn-time0123-03", "event": "rare.time0123", "text": "一点二十三。种子也不是一下就变成草。", "weight": 2, "rarity": "rare" },
    { "id": "grass-buddy-zh-cn-time0520-01", "event": "rare.time0520", "text": "05:20。有点喜欢。说完了，继续当草。", "weight": 2, "rarity": "rare" },
    { "id": "grass-buddy-zh-cn-time0520-02", "event": "rare.time0520", "text": "五二零。喜欢先发个小芽，不用开很大的花。", "weight": 2, "rarity": "rare" },
    { "id": "grass-buddy-zh-cn-time0520-03", "event": "rare.time0520", "text": "五点二十。借这三个数，轻轻打个招呼。", "weight": 2, "rarity": "rare" },
    { "id": "grass-buddy-zh-cn-time0808-01", "event": "rare.time0808", "text": "08:08。草已开机。看起来没区别。", "weight": 2, "rarity": "rare" },
    { "id": "grass-buddy-zh-cn-time0808-02", "event": "rare.time0808", "text": "八点零八。营业项目：缓慢变绿。", "weight": 2, "rarity": "rare" },
    { "id": "grass-buddy-zh-cn-time0808-03", "event": "rare.time0808", "text": "两个八都精神。我伸一片叶子意思一下。", "weight": 2, "rarity": "rare" },
    { "id": "grass-buddy-zh-cn-time0909-01", "event": "rare.time0909", "text": "09:09。长久这件事，草略懂。", "weight": 2, "rarity": "rare" },
    { "id": "grass-buddy-zh-cn-time0909-02", "event": "rare.time0909", "text": "两个九。慢慢长，不必长给谁看。", "weight": 2, "rarity": "rare" },
    { "id": "grass-buddy-zh-cn-time0909-03", "event": "rare.time0909", "text": "九点零九。根每天挪一点，没有进度条。", "weight": 2, "rarity": "rare" },
    { "id": "grass-buddy-zh-cn-time1111-01", "event": "rare.time1111", "text": "11:11。四根小草。适合种个愿望。", "weight": 2, "rarity": "rare" },
    { "id": "grass-buddy-zh-cn-time1111-02", "event": "rare.time1111", "text": "四个一。我许愿土松一点。很具体。", "weight": 2, "rarity": "rare" },
    { "id": "grass-buddy-zh-cn-time1111-03", "event": "rare.time1111", "text": "十一点十一。愿望先种下，别每分钟挖出来看。", "weight": 2, "rarity": "rare" },
    { "id": "grass-buddy-zh-cn-time1234-01", "event": "rare.time1234", "text": "12:34。按顺序来。我不太会插队。", "weight": 2, "rarity": "rare" },
    { "id": "grass-buddy-zh-cn-time1234-02", "event": "rare.time1234", "text": "一二三四。先长根，再考虑别的造型。", "weight": 2, "rarity": "rare" },
    { "id": "grass-buddy-zh-cn-time1234-03", "event": "rare.time1234", "text": "十二点三十四。下一小步，也是一种进展。", "weight": 2, "rarity": "rare" },
    { "id": "grass-buddy-zh-cn-time1314-01", "event": "rare.time1314", "text": "13:14。不会说长话。可以安静待一会。", "weight": 2, "rarity": "rare" },
    { "id": "grass-buddy-zh-cn-time1314-02", "event": "rare.time1314", "text": "一三一四。很长的意思。我先长好今天。", "weight": 2, "rarity": "rare" },
    { "id": "grass-buddy-zh-cn-time1314-03", "event": "rare.time1314", "text": "十三点十四。陪着，也不一定要说话。比如草。", "weight": 2, "rarity": "rare" },
    { "id": "grass-buddy-zh-cn-time1720-01", "event": "rare.time1720", "text": "17:20。下午的五二零。喜欢，补种一颗。", "weight": 2, "rarity": "rare" },
    { "id": "grass-buddy-zh-cn-time1720-02", "event": "rare.time1720", "text": "五点二十。你在旁边挺好。这不是光合作用。", "weight": 2, "rarity": "rare" },
    { "id": "grass-buddy-zh-cn-time1720-03", "event": "rare.time1720", "text": "17:20。小小告白。叶子不红，心意到了。", "weight": 2, "rarity": "rare" },
    { "id": "grass-buddy-zh-cn-time2020-01", "event": "rare.time2020", "text": "20:20。看看今天。有些生长藏在土里。", "weight": 2, "rarity": "rare" },
    { "id": "grass-buddy-zh-cn-time2020-02", "event": "rare.time2020", "text": "两个二十。今天的小好事，值得再认领一次。", "weight": 2, "rarity": "rare" },
    { "id": "grass-buddy-zh-cn-time2020-03", "event": "rare.time2020", "text": "二十点二十。今日回顾：绿着。也算一项。", "weight": 2, "rarity": "rare" },
    { "id": "grass-buddy-zh-cn-time2222-01", "event": "rare.time2222", "text": "22:22。双份休息。不需要双倍努力来换。", "weight": 2, "rarity": "rare" },
    { "id": "grass-buddy-zh-cn-time2222-02", "event": "rare.time2222", "text": "四个二。我申请两片叶子一起放松。", "weight": 2, "rarity": "rare" },
    { "id": "grass-buddy-zh-cn-time2222-03", "event": "rare.time2222", "text": "二十二点二十二。慢两拍。正好是我的速度。", "weight": 2, "rarity": "rare" },
    { "id": "grass-buddy-zh-cn-time2359-01", "event": "rare.time2359", "text": "23:59。还有一分钟。不够长大，够松口气。", "weight": 2, "rarity": "rare" },
    { "id": "grass-buddy-zh-cn-time2359-02", "event": "rare.time2359", "text": "离明天差一分钟。没发的芽，不算作废。", "weight": 2, "rarity": "rare" },
    { "id": "grass-buddy-zh-cn-time2359-03", "event": "rare.time2359", "text": "二十三点五十九。剩下的，明天接着长。", "weight": 2, "rarity": "rare" }
  ]
}
