{
  "category": "state-variants",
  "phrases": [
    { "id": "gbzcn-v2-idle-morning-01", "event": "idle.chatter", "text": "早上的光到了。我慢一点接住。", "weight": 3, "cooldownMs": 7200000, "conditions": { "hourMin": 5, "hourMax": 10 } },
    { "id": "gbzcn-v2-idle-morning-02", "event": "idle.chatter", "text": "桌面醒了。叶子还在加载。", "weight": 3, "cooldownMs": 7200000, "conditions": { "hourMin": 5, "hourMax": 10 } },
    { "id": "gbzcn-v2-idle-day-01", "event": "idle.chatter", "text": "事情堆起来了。像土，不像好土。", "weight": 3, "cooldownMs": 7200000, "conditions": { "hourMin": 11, "hourMax": 16 } },
    { "id": "gbzcn-v2-idle-day-02", "event": "idle.chatter", "text": "下午的风很慢。适合把一件事做完。", "weight": 3, "cooldownMs": 7200000, "conditions": { "hourMin": 11, "hourMax": 16 } },
    { "id": "gbzcn-v2-idle-evening-01", "event": "idle.chatter", "text": "光快没了。任务还没落叶。", "weight": 3, "cooldownMs": 7200000, "conditions": { "hourMin": 17, "hourMax": 23 } },
    { "id": "gbzcn-v2-idle-evening-02", "event": "idle.chatter", "text": "今天可以收根了。大概。", "weight": 3, "cooldownMs": 7200000, "conditions": { "hourMin": 17, "hourMax": 23 } },
    { "id": "gbzcn-v2-idle-late-01", "event": "idle.lateNight", "text": "这个时间没有太阳。你还在发光。", "weight": 4, "cooldownMs": 7200000 },
    { "id": "gbzcn-v2-idle-late-02", "event": "idle.lateNight", "text": "夜里风小。键盘声很大。", "weight": 4, "cooldownMs": 7200000 },
    { "id": "gbzcn-v2-idle-late-03", "event": "idle.lateNight", "text": "叶子已经合上了。剩下是习惯。", "weight": 3, "cooldownMs": 7200000 },
    { "id": "gbzcn-v2-idle-weekend-01", "event": "idle.weekend", "text": "周末还在忙。根没有意见。", "weight": 4, "cooldownMs": 21600000 },
    { "id": "gbzcn-v2-idle-weekend-02", "event": "idle.weekend", "text": "今天可以长得慢一点。", "weight": 4, "cooldownMs": 21600000 },
    { "id": "gbzcn-v2-idle-weekend-03", "event": "idle.weekend", "text": "休息日的空地，不必种满。", "weight": 3, "cooldownMs": 21600000 },
    { "id": "gbzcn-v2-idle-session-01", "event": "idle.longSession", "text": "坐太久了。根会误会。起来走走。", "weight": 5, "cooldownMs": 7200000 },
    { "id": "gbzcn-v2-idle-session-02", "event": "idle.longSession", "text": "这一段很长。先喝水。", "weight": 4, "cooldownMs": 7200000 },
    { "id": "gbzcn-v2-idle-session-03", "event": "idle.longSession", "text": "眼睛换个远处。叶尖也不该一直盯。", "weight": 4, "cooldownMs": 7200000 },

    { "id": "gbzcn-v2-schedule-half-01", "event": "schedule.halfHour", "text": "又过半小时。肩膀松一点。", "weight": 4 },
    { "id": "gbzcn-v2-schedule-half-02", "event": "schedule.halfHour", "text": "三十分钟长过去了。起来动动。", "weight": 4 },
    { "id": "gbzcn-v2-schedule-half-03", "event": "schedule.halfHour", "text": "时间掉了一片叶。继续。", "weight": 3 },
    { "id": "gbzcn-v2-schedule-lunch-01", "event": "schedule.lunchSoon", "text": "快到午饭了。咖啡不算土壤。", "weight": 5 },
    { "id": "gbzcn-v2-schedule-lunch-02", "event": "schedule.lunchSoon", "text": "还有五分钟。先把这一枝收住。", "weight": 4 },
    { "id": "gbzcn-v2-schedule-lunch-03", "event": "schedule.lunchSoon", "text": "该离开屏幕吃饭了。", "weight": 3 },
    { "id": "gbzcn-v2-schedule-off-half-01", "event": "schedule.offWorkHalfHour", "text": "离下班半小时。别再种新坑。", "weight": 5 },
    { "id": "gbzcn-v2-schedule-off-half-02", "event": "schedule.offWorkHalfHour", "text": "还有三十分钟。开始收叶子。", "weight": 4 },
    { "id": "gbzcn-v2-schedule-off-half-03", "event": "schedule.offWorkHalfHour", "text": "快到边上了。记好明天从哪继续。", "weight": 3 },
    { "id": "gbzcn-v2-schedule-off-01", "event": "schedule.offWorkSoon", "text": "剩五分钟。保存，检查，收工。", "weight": 5 },
    { "id": "gbzcn-v2-schedule-off-02", "event": "schedule.offWorkSoon", "text": "快下班了。最后不要长出新枝。", "weight": 4 },
    { "id": "gbzcn-v2-schedule-off-03", "event": "schedule.offWorkSoon", "text": "今天先到这里。明天还能接着长。", "weight": 3 },

    { "id": "gbzcn-v2-agent-start-01", "event": "agent.started", "text": "任务开始了。往前长。", "weight": 5 },
    { "id": "gbzcn-v2-agent-start-02", "event": "agent.started", "text": "又有一件在动。风来了。", "weight": 4 },
    { "id": "gbzcn-v2-agent-start-03", "event": "agent.started", "text": "现在有 {activeCount} 件一起长。别挤。", "weight": 3, "conditions": { "activeCountMin": 2 } },
    { "id": "gbzcn-v2-agent-input-01", "event": "agent.needsInput", "text": "它停在需要你回答的地方。", "weight": 5 },
    { "id": "gbzcn-v2-agent-input-02", "event": "agent.needsInput", "text": "这一步要你决定。根不能代签。", "weight": 5 },
    { "id": "gbzcn-v2-agent-input-03", "event": "agent.needsInput", "text": "有个选择在等。先看一下。", "weight": 4 },
    { "id": "gbzcn-v2-agent-complete-01", "event": "agent.completed", "text": "这一件长完了。检查结果。", "weight": 5 },
    { "id": "gbzcn-v2-agent-complete-02", "event": "agent.completed", "text": "少一枝。桌面宽一点了。", "weight": 4 },
    { "id": "gbzcn-v2-agent-complete-03", "event": "agent.completed", "text": "收好一件，还有 {remaining} 件在长。", "weight": 4, "conditions": { "remainingMin": 1 } },
    { "id": "gbzcn-v2-agent-all-01", "event": "agent.allCompleted", "text": "全部长完了。先站稳。", "weight": 5 },
    { "id": "gbzcn-v2-agent-all-02", "event": "agent.allCompleted", "text": "都完成了。不要马上播下一批种子。", "weight": 4 },
    { "id": "gbzcn-v2-agent-all-03", "event": "agent.allCompleted", "text": "任务安静了。风也停一下。", "weight": 4 },
    { "id": "gbzcn-v2-agent-fail-01", "event": "agent.failed", "text": "这一枝没长好。错误还在。", "weight": 5 },
    { "id": "gbzcn-v2-agent-fail-02", "event": "agent.failed", "text": "它在半路折了。先找原因。", "weight": 5 },
    { "id": "gbzcn-v2-agent-fail-03", "event": "agent.failed", "text": "结果不对。需要重新看土。", "weight": 4 },
    { "id": "gbzcn-v2-agent-long-01", "event": "agent.longRunning", "text": "跑很久了。这段根很深。", "weight": 5, "conditions": { "durationMinSeconds": 1200 } },
    { "id": "gbzcn-v2-agent-long-02", "event": "agent.longRunning", "text": "它还在处理。叶尖还在动。", "weight": 4, "conditions": { "durationMinSeconds": 1200 } },
    { "id": "gbzcn-v2-agent-long-03", "event": "agent.longRunning", "text": "四十分钟了。看看是不是绕进藤里。", "weight": 3, "conditions": { "durationMinSeconds": 2400 } },
    { "id": "gbzcn-v2-agent-ended-01", "event": "agent.ended", "text": "这一轮停了。看看长成什么。", "weight": 5 },
    { "id": "gbzcn-v2-agent-ended-02", "event": "agent.ended", "text": "它结束了。风忽然小了。", "weight": 4 },
    { "id": "gbzcn-v2-agent-all-ended-01", "event": "agent.allEnded", "text": "全部停了。结果另看。", "weight": 5 },
    { "id": "gbzcn-v2-agent-all-ended-02", "event": "agent.allEnded", "text": "现在没有任务在动。先留白。", "weight": 4 },

    { "id": "gbzcn-v2-calendar-upcoming-01", "event": "calendar.upcoming", "text": "还有 {minutes} 分钟。手上的枝该收了。", "weight": 5, "conditions": { "requires": ["minutes"] } },
    { "id": "gbzcn-v2-calendar-upcoming-02", "event": "calendar.upcoming", "text": "「{title}」快到了。日历记得。", "weight": 4, "conditions": { "requires": ["title"] } },
    { "id": "gbzcn-v2-calendar-upcoming-03", "event": "calendar.upcoming", "text": "下一个安排靠近了。准备换方向。", "weight": 3 },
    { "id": "gbzcn-v2-calendar-start-01", "event": "calendar.starting", "text": "安排开始了。该换一块地。", "weight": 5 },
    { "id": "gbzcn-v2-calendar-start-02", "event": "calendar.starting", "text": "「{title}」现在开始。", "weight": 4, "conditions": { "requires": ["title"] } },
    { "id": "gbzcn-v2-calendar-start-03", "event": "calendar.starting", "text": "时间到了。桌面还在这里。", "weight": 3 },
    { "id": "gbzcn-v2-calendar-busy-01", "event": "calendar.busyDay", "text": "今天排得很密。没有多少空地。", "weight": 4, "cooldownMs": 21600000 },
    { "id": "gbzcn-v2-calendar-busy-02", "event": "calendar.busyDay", "text": "日历长得太挤。留一点风。", "weight": 3, "cooldownMs": 21600000 },
    { "id": "gbzcn-v2-calendar-free-01", "event": "calendar.freeGap", "text": "前面有一块空地。先留着。", "weight": 4, "cooldownMs": 10800000 },
    { "id": "gbzcn-v2-calendar-free-02", "event": "calendar.freeGap", "text": "暂时没安排。让风进来。", "weight": 3, "cooldownMs": 10800000 },

    { "id": "gbzcn-v2-system-unlock-01", "event": "system.unlocked", "text": "你回来了。刚才没有风。", "weight": 4, "cooldownMs": 1800000 },
    { "id": "gbzcn-v2-system-unlock-02", "event": "system.unlocked", "text": "屏幕亮了。叶子也展开。", "weight": 4, "cooldownMs": 1800000 },
    { "id": "gbzcn-v2-system-error-01", "event": "system.error", "text": "这里断了一根。不是安静。", "weight": 5, "cooldownMs": 300000 },
    { "id": "gbzcn-v2-system-error-02", "event": "system.error", "text": "它没按方向长。看一下。", "weight": 4, "cooldownMs": 300000 },
    { "id": "gbzcn-v2-battery-20", "event": "system.battery", "text": "20%。可以开始找电源。", "weight": 2, "conditions": { "batteryEquals": 20 } },
    { "id": "gbzcn-v2-battery-10", "event": "system.battery", "text": "10%。电源线该出土了。", "weight": 2, "conditions": { "batteryEquals": 10 } },
    { "id": "gbzcn-v2-battery-5", "event": "system.battery", "text": "5%。现在去拿充电器。", "weight": 2, "conditions": { "batteryEquals": 5 } },
    { "id": "gbzcn-v2-integration-01", "event": "system.integrationReady", "text": "任务状态接通了。动静会传过来。", "weight": 4 },
    { "id": "gbzcn-v2-integration-02", "event": "system.integrationReady", "text": "连上了。风从那边来。", "weight": 3 },
    { "id": "gbzcn-v2-memory-exit-01", "event": "system.memoryExit", "text": "内存一直太高。我先把叶子合上。", "weight": 2 },

    { "id": "gbzcn-v2-clock-appear-01", "event": "clock.alarmClockAppeared", "text": "闹钟拿好了。这片叶子有事做。", "weight": 4 },
    { "id": "gbzcn-v2-clock-disappear-01", "event": "clock.alarmClockDisappeared", "text": "闹钟收了。叶尖空出来。", "weight": 4 },
    { "id": "gbzcn-v2-clock-ring-01", "event": "clock.alarmRinging", "text": "时间到了。声音已经长出来了。", "weight": 5 },
    { "id": "gbzcn-v2-clock-ring-02", "event": "clock.alarmRinging", "text": "「{label}」在响。该动了。", "weight": 4, "conditions": { "requires": ["label"] } },
    { "id": "gbzcn-v2-timer-start-01", "event": "clock.timerStarted", "text": "计时开始。数字往下长。", "weight": 5 },
    { "id": "gbzcn-v2-timer-start-02", "event": "clock.timerStarted", "text": "时间开始走了。先做眼前这一件。", "weight": 4 },
    { "id": "gbzcn-v2-timer-pause-01", "event": "clock.timerPaused", "text": "计时停住。风也停一下。", "weight": 4 },
    { "id": "gbzcn-v2-timer-resume-01", "event": "clock.timerResumed", "text": "时间又走了。继续。", "weight": 4 },
    { "id": "gbzcn-v2-timer-extend-01", "event": "clock.timerExtended", "text": "时间延长了。边界往后挪。", "weight": 4 },
    { "id": "gbzcn-v2-timer-cancel-01", "event": "clock.timerCancelled", "text": "计时取消。数字不用再长。", "weight": 4 },
    { "id": "gbzcn-v2-timer-done-01", "event": "clock.timerCompleted", "text": "计时结束。停一下，抬头。", "weight": 5 },
    { "id": "gbzcn-v2-timer-done-02", "event": "clock.timerCompleted", "text": "「{label}」的时间到了。", "weight": 4, "conditions": { "requires": ["label"] } },
    { "id": "gbzcn-v2-alert-snooze-01", "event": "clock.alertSnoozed", "text": "再等一会。提醒还会发芽。", "weight": 4 },
    { "id": "gbzcn-v2-alert-dismiss-01", "event": "clock.alertDismissed", "text": "提醒关了。事情别一起关。", "weight": 4 },
    { "id": "gbzcn-v2-alert-missed-01", "event": "clock.missedAfterWake", "text": "睡着时错过了提醒。现在补上。", "weight": 5 },

    { "id": "gbzcn-v2-visit-start-01", "event": "messenger.visitStart", "text": "去串门。根暂时留在这里。", "weight": 4 },
    { "id": "gbzcn-v2-visit-accept-01", "event": "messenger.visitAccept", "text": "好。我过来站一会。", "weight": 4 },
    { "id": "gbzcn-v2-visit-idle-01", "event": "messenger.visitIdle", "text": "一起站着就行。风会说话。", "weight": 4, "cooldownMs": 3600000 },
    { "id": "gbzcn-v2-visit-idle-02", "event": "messenger.visitIdle", "text": "两边都安静。这也算串门。", "weight": 3, "cooldownMs": 3600000 },
    { "id": "gbzcn-v2-visit-end-01", "event": "messenger.visitEnd", "text": "串门结束。回去扎根。", "weight": 4 },
    { "id": "gbzcn-v2-message-sent-01", "event": "messenger.sent", "text": "传出去了。等对面回风。", "weight": 5 },
    { "id": "gbzcn-v2-message-sent-02", "event": "messenger.sent", "text": "消息送到。叶子可以放下。", "weight": 4 },
    { "id": "gbzcn-v2-friend-hit-01", "event": "messenger.friendHit", "text": "碰一下就够。我不是门铃。", "weight": 5 },
    { "id": "gbzcn-v2-friend-hit-02", "event": "messenger.friendHit", "text": "别再拍。叶尖会乱。", "weight": 4 },
    { "id": "gbzcn-v2-remote-pet-01", "event": "messenger.remote.pet", "text": "摸到了。像一阵小风。", "weight": 4 },
    { "id": "gbzcn-v2-remote-hug-01", "event": "messenger.remote.hug", "text": "抱住了。别压到根。", "weight": 4 },
    { "id": "gbzcn-v2-remote-highfive-01", "event": "messenger.remote.highFive", "text": "击掌完成。叶子响了一下。", "weight": 4 },
    { "id": "gbzcn-v2-remote-launch-01", "event": "messenger.remote.launch", "text": "飞起来了。根没有跟上。", "weight": 4 },
    { "id": "gbzcn-v2-remote-bomb-01", "event": "messenger.remote.bomb", "text": "炸完了。叶子上有灰。", "weight": 4 },
    { "id": "gbzcn-v2-remote-vortex-01", "event": "messenger.remote.vortex", "text": "转太久了。叶尖不知道朝哪。", "weight": 4 },
    { "id": "gbzcn-v2-remote-wave-01", "event": "messenger.remote.wave", "text": "浪来了。水有点多。", "weight": 4 },
    { "id": "gbzcn-v2-remote-bubble-01", "event": "messenger.remote.bubble", "text": "泡泡包住了叶子。先待着。", "weight": 4 },

    { "id": "gbzcn-v2-click-01", "event": "interaction.click", "text": "碰到了。叶尖记得。", "weight": 4 },
    { "id": "gbzcn-v2-click-02", "event": "interaction.click", "text": "你点了。这里不会开花。", "weight": 4 },
    { "id": "gbzcn-v2-menu-01", "event": "interaction.menuOpen", "text": "菜单开了。我先站住。", "weight": 4 },
    { "id": "gbzcn-v2-petting-01", "event": "interaction.petting", "text": "轻一点。叶子有方向。", "weight": 5 },
    { "id": "gbzcn-v2-petting-02", "event": "interaction.petting", "text": "这一下可以。像风。", "weight": 4 },
    { "id": "gbzcn-v2-petting-more-01", "event": "interaction.pettingMore", "text": "还在摸。叶子先不合。", "weight": 4 },
    { "id": "gbzcn-v2-petting-lots-01", "event": "interaction.pettingLots", "text": "够久了。叶片已经排整齐。", "weight": 4 },
    { "id": "gbzcn-v2-idle-roam-on-01", "event": "interaction.idleRoamOn", "text": "没任务也走。根先收好。", "weight": 4 },
    { "id": "gbzcn-v2-task-roam-on-01", "event": "interaction.taskRoamOn", "text": "任务动，我也走。风向一致。", "weight": 4 },
    { "id": "gbzcn-v2-goodbye-01", "event": "interaction.goodbye", "text": "那我收叶子了。下次再展开。", "weight": 4 },

    { "id": "gbzcn-v2-rare-night-01", "event": "rare.lateNight", "text": "凌晨的任务也不见光。", "weight": 1, "rarity": "rare", "conditions": { "hourMin": 0, "hourMax": 4 } },
    { "id": "gbzcn-v2-rare-friday-01", "event": "rare.friday", "text": "星期五。风松了一点。", "weight": 1, "rarity": "rare", "conditions": { "weekdays": [5] } },
    { "id": "gbzcn-v2-rare-finished-01", "event": "rare.allCompletedFollowUp", "text": "都长完了。空地还在。", "weight": 1, "rarity": "rare" },
    { "id": "gbzcn-v2-rare-return-01", "event": "rare.returnAfterLongLock", "text": "你走了很久。光换过一轮。", "weight": 1, "rarity": "rare", "conditions": { "lockedMinSeconds": 7200 } },
    { "id": "gbzcn-v2-rare-clicks-01", "event": "rare.tooManyClicks", "text": "点这么多次，也只长原来的草。", "weight": 1, "rarity": "rare", "conditions": { "clickCountMin": 10 } }
  ]
}
