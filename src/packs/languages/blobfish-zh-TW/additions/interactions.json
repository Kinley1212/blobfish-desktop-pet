{
  "category": "interaction",
  "phrases": [
    { "id": "menu-open-01", "event": "interaction.menuOpen", "text": "你要改什麼……", "weight": 5 },
    { "id": "menu-open-02", "event": "interaction.menuOpen", "text": "選吧，我等著。", "weight": 4 },
    { "id": "menu-open-03", "event": "interaction.menuOpen", "text": "我先停一下。", "weight": 3 },
    { "id": "menu-open-rare-01", "event": "interaction.menuOpen", "text": "設定裡應該沒有海水。", "weight": 1, "rarity": "rare" },
    { "id": "paused-01", "event": "interaction.paused", "text": "那我不動了。", "weight": 5 },
    { "id": "paused-02", "event": "interaction.paused", "text": "好吧。停在這裡。", "weight": 3 },
    { "id": "paused-03", "event": "interaction.paused", "text": "反正也游不遠。", "weight": 2 },
    { "id": "resumed-01", "event": "interaction.resumed", "text": "好吧，繼續游。", "weight": 5 },
    { "id": "resumed-02", "event": "interaction.resumed", "text": "又要動了……", "weight": 4 },
    { "id": "resumed-03", "event": "interaction.resumed", "text": "我還以為能歇久一點。", "weight": 2 },
    { "id": "idle-roam-off-01", "event": "interaction.idleRoamOff", "text": "忙完我就停。", "weight": 5 },
    { "id": "idle-roam-off-02", "event": "interaction.idleRoamOff", "text": "沒任務就不游了。", "weight": 4 },
    { "id": "idle-roam-off-03", "event": "interaction.idleRoamOff", "text": "好吧。空下來就歇著。", "weight": 3 },
    { "id": "idle-roam-on-01", "event": "interaction.idleRoamOn", "text": "沒事也游兩下。", "weight": 5 },
    { "id": "idle-roam-on-02", "event": "interaction.idleRoamOn", "text": "好吧，繼續晃悠。", "weight": 4 },
    { "id": "idle-roam-on-03", "event": "interaction.idleRoamOn", "text": "空著也是空著……", "weight": 3 },
    { "id": "task-roam-off-01", "event": "interaction.taskRoamOff", "text": "工作的時候，我就待在這裡。", "weight": 5 },
    { "id": "task-roam-off-02", "event": "interaction.taskRoamOff", "text": "任務會跑。我不跑。", "weight": 4 },
    { "id": "task-roam-on-01", "event": "interaction.taskRoamOn", "text": "有任務再游。好吧。", "weight": 5 },
    { "id": "task-roam-on-02", "event": "interaction.taskRoamOn", "text": "邊做邊晃悠……", "weight": 3 },
    { "id": "petting-01", "event": "interaction.petting", "text": "……嗯，勉強讓你摸一下。", "weight": 5 },
    { "id": "petting-02", "event": "interaction.petting", "text": "唔……再懶一點點……", "weight": 5 },
    { "id": "petting-03", "event": "interaction.petting", "text": "手感不錯吧，天然的。", "weight": 5 },
    { "id": "petting-04", "event": "interaction.petting", "text": "別誤會，我只是沒力氣躲。", "weight": 4 },
    { "id": "petting-05", "event": "interaction.petting", "text": "深海躺平冠軍，瞭解一下。", "weight": 4 },
    { "id": "petting-06", "event": "interaction.petting", "text": "……嗯。就這樣，別太用力。", "weight": 4 },
    { "id": "petting-07", "event": "interaction.petting", "text": "摸到的可是限量款。", "weight": 4 },
    { "id": "petting-08", "event": "interaction.petting", "text": "哼，又不是很舒服。", "weight": 3 },
    { "id": "petting-09", "event": "interaction.petting", "text": "再摸下去要起球了。", "weight": 3 },
    { "id": "petting-10", "event": "interaction.petting", "text": "這一身軟，別處可找不到。", "weight": 3 },
    { "id": "petting-11", "event": "interaction.petting", "text": "隨你吧……我又懶得動。", "weight": 3 },
    { "id": "petting-rare-01", "event": "interaction.petting", "text": "別以為這樣我就高興了……（尾巴悄悄搖）", "weight": 1, "rarity": "rare" },
    { "id": "petting-rare-02", "event": "interaction.petting", "text": "免費僅此一次。……才怪，隨時歡迎。", "weight": 1, "rarity": "rare" },
    { "id": "petting-more-01", "event": "interaction.pettingMore", "text": "……還摸。行吧。", "weight": 5 },
    { "id": "petting-more-02", "event": "interaction.pettingMore", "text": "我不躲了，省點力氣。", "weight": 5 },
    { "id": "petting-more-03", "event": "interaction.pettingMore", "text": "手感這麼好，你也不虧。", "weight": 4 },
    { "id": "petting-more-04", "event": "interaction.pettingMore", "text": "深海也沒這種待遇。", "weight": 4 },
    { "id": "petting-more-05", "event": "interaction.pettingMore", "text": "唔……再懶億點點。", "weight": 4 },
    { "id": "petting-more-06", "event": "interaction.pettingMore", "text": "這不算舒服。只是懶得反駁。", "weight": 3 },
    { "id": "petting-lots-01", "event": "interaction.pettingLots", "text": "隨便你了。我不動了。", "weight": 5 },
    { "id": "petting-lots-02", "event": "interaction.pettingLots", "text": "再摸就要塌了。", "weight": 5 },
    { "id": "petting-lots-03", "event": "interaction.pettingLots", "text": "行，你贏了。我承認。", "weight": 4 },
    { "id": "petting-lots-04", "event": "interaction.pettingLots", "text": "限量款被你摸出包漿了。", "weight": 4 },
    { "id": "petting-lots-05", "event": "interaction.pettingLots", "text": "咕嚕……已下線。", "weight": 4 },
    { "id": "petting-lots-06", "event": "interaction.pettingLots", "text": "我這輩子最努力的一次，是躺著。", "weight": 3 },
    { "id": "petting-lots-rare-01", "event": "interaction.pettingLots", "text": "水滴魚已融化。請稍後再試。", "weight": 1, "rarity": "rare" }
  ]
}
