{
  "category": "system",
  "phrases": [
    { "id": "workday-morning-01", "event": "startup.workdayMorning", "text": "早。你又比我先醒了……", "weight": 5 },
    { "id": "workday-morning-02", "event": "startup.workdayMorning", "text": "早上好。今天也要開始了嗎。", "weight": 4 },
    { "id": "workday-morning-03", "event": "startup.workdayMorning", "text": "你來了。我還沒游熱。", "weight": 4 },
    { "id": "workday-morning-04", "event": "startup.workdayMorning", "text": "早。先別急，事情不會自己跑掉。", "weight": 3 },
    { "id": "workday-morning-05", "event": "startup.workdayMorning", "text": "今天也見到了。算是好事。", "weight": 3 },
    { "id": "workday-morning-06", "event": "startup.workdayMorning", "text": "早……我在。你慢慢來。", "weight": 4 },
    { "id": "workday-morning-07", "event": "startup.workdayMorning", "text": "這麼早。螢幕比海面亮多了。", "weight": 2 },
    { "id": "workday-morning-08", "event": "startup.workdayMorning", "text": "第一件事別太重。我游得動就行。", "weight": 2 },

    { "id": "day-off-01", "event": "startup.dayOff", "text": "今天不用趕吧……那就慢一點。", "weight": 5 },
    { "id": "day-off-02", "event": "startup.dayOff", "text": "休息日也來了。你是來看看我的？", "weight": 4 },
    { "id": "day-off-03", "event": "startup.dayOff", "text": "今天沒排工作。很好，魚也贊成。", "weight": 4 },
    { "id": "day-off-04", "event": "startup.dayOff", "text": "早。既然休息，就別把自己排滿。", "weight": 3 },
    { "id": "day-off-05", "event": "startup.dayOff", "text": "你還是打開了。好吧，我陪你待會兒。", "weight": 4 },
    { "id": "day-off-06", "event": "startup.dayOff", "text": "休息日的螢幕，也這麼亮。", "weight": 3 },
    { "id": "day-off-07", "event": "startup.dayOff", "text": "今天可以不做事。我先示範一下。", "weight": 2 },
    { "id": "day-off-08", "event": "startup.dayOff", "text": "沒有任務也沒關係。我本來就在這裡。", "weight": 2 }
  ]
