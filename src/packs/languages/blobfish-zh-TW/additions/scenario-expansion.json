{
  "category": "scenario",
  "phrases": [
    {
      "id": "bf-scenario-001",
      "event": "idle.chatter",
      "text": "早上的光太積極了。我還沒有。",
      "weight": 2,
      "conditions": {
        "hourMin": 5,
        "hourMax": 10
      },
      "cooldownMs": 3600000
    },
    {
      "id": "bf-scenario-002",
      "event": "idle.chatter",
      "text": "天已經亮了。魚的反應還在路上。",
      "weight": 2,
      "conditions": {
        "hourMin": 5,
        "hourMax": 10
      },
      "cooldownMs": 3600000
    },
    {
      "id": "bf-scenario-003",
      "event": "idle.chatter",
      "text": "早起這件事。我只是路過。",
      "weight": 2,
      "conditions": {
        "hourMin": 5,
        "hourMax": 10
      },
      "cooldownMs": 3600000
    },
    {
      "id": "bf-scenario-004",
      "event": "idle.chatter",
      "text": "先讓我浮一會兒。今天還長。",
      "weight": 2,
      "conditions": {
        "hourMin": 5,
        "hourMax": 10
      },
      "cooldownMs": 3600000
    },
    {
      "id": "bf-scenario-005",
      "event": "idle.chatter",
      "text": "螢幕醒了。別要求魚也立刻精神。",
      "weight": 2,
      "conditions": {
        "hourMin": 5,
        "hourMax": 10
      },
      "cooldownMs": 3600000
    },
    {
      "id": "bf-scenario-006",
      "event": "idle.chatter",
      "text": "下午的時間。好像比我還懶。",
      "weight": 2,
      "conditions": {
        "hourMin": 11,
        "hourMax": 16
      },
      "cooldownMs": 3600000
    },
    {
      "id": "bf-scenario-007",
      "event": "idle.chatter",
      "text": "這個時候。連泡泡都不想上班。",
      "weight": 2,
      "conditions": {
        "hourMin": 11,
        "hourMax": 16
      },
      "cooldownMs": 3600000
    },
    {
      "id": "bf-scenario-008",
      "event": "idle.chatter",
      "text": "游了一圈。事情還在原來的位置。",
      "weight": 2,
      "conditions": {
        "hourMin": 11,
        "hourMax": 16
      },
      "cooldownMs": 3600000
    },
    {
      "id": "bf-scenario-009",
      "event": "idle.chatter",
      "text": "眼睛累了就看看遠處。我不會丟。",
      "weight": 2,
      "conditions": {
        "hourMin": 11,
        "hourMax": 16
      },
      "cooldownMs": 3600000
    },
    {
      "id": "bf-scenario-010",
      "event": "idle.chatter",
      "text": "午後的精神。大概還留在飯桌上。",
      "weight": 2,
      "conditions": {
        "hourMin": 11,
        "hourMax": 16
      },
      "cooldownMs": 3600000
    },
    {
      "id": "bf-scenario-011",
      "event": "idle.chatter",
      "text": "天色暗了一點。今天也用掉不少了。",
      "weight": 2,
      "conditions": {
        "hourMin": 17,
        "hourMax": 23
      },
      "cooldownMs": 3600000
    },
    {
      "id": "bf-scenario-012",
      "event": "idle.chatter",
      "text": "事情做不完。也可以先喘一口氣。",
      "weight": 2,
      "conditions": {
        "hourMin": 17,
        "hourMax": 23
      },
      "cooldownMs": 3600000
    },
    {
      "id": "bf-scenario-013",
      "event": "idle.chatter",
      "text": "晚上的螢幕。比魚有精神多了。",
      "weight": 2,
      "conditions": {
        "hourMin": 17,
        "hourMax": 23
      },
      "cooldownMs": 3600000
    },
    {
      "id": "bf-scenario-014",
      "event": "idle.chatter",
      "text": "肩膀放鬆一點。我看著都累。",
      "weight": 2,
      "conditions": {
        "hourMin": 17,
        "hourMax": 23
      },
      "cooldownMs": 3600000
    },
    {
      "id": "bf-scenario-015",
      "event": "idle.chatter",
      "text": "今天先不評分。能坐穩就不錯了。",
      "weight": 2,
      "conditions": {
        "hourMin": 17,
        "hourMax": 23
      },
      "cooldownMs": 3600000
    },
    {
      "id": "bf-scenario-016",
      "event": "idle.chatter",
      "text": "這個時間。海底應該也在關燈。",
      "weight": 2,
      "conditions": {
        "hourMin": 0,
        "hourMax": 4
      },
      "cooldownMs": 3600000
    },
    {
      "id": "bf-scenario-017",
      "event": "idle.chatter",
      "text": "夜已經很深了。我還沒那麼深。",
      "weight": 2,
      "conditions": {
        "hourMin": 0,
        "hourMax": 4
      },
      "cooldownMs": 3600000
    },
    {
      "id": "bf-scenario-018",
      "event": "idle.chatter",
      "text": "困了就去睡。魚不需要人值夜。",
      "weight": 2,
      "conditions": {
        "hourMin": 0,
        "hourMax": 4
      },
      "cooldownMs": 3600000
    },
    {
      "id": "bf-scenario-019",
      "event": "idle.chatter",
      "text": "螢幕還亮著。希望不是又忘了時間。",
      "weight": 2,
      "conditions": {
        "hourMin": 0,
        "hourMax": 4
      },
      "cooldownMs": 3600000
    },
    {
      "id": "bf-scenario-020",
      "event": "idle.chatter",
      "text": "先別和明天借精神。利息很高。",
      "weight": 2,
      "conditions": {
        "hourMin": 0,
        "hourMax": 4
      },
      "cooldownMs": 3600000
    },
    {
      "id": "bf-scenario-021",
      "event": "startup.workdayMorning",
      "text": "又到工作日了。先別把事情全抱過來。",
      "weight": 2,
      "cooldownMs": 600000
    },
    {
      "id": "bf-scenario-022",
      "event": "startup.workdayMorning",
      "text": "早。今天的第一口氣先留給自己。",
      "weight": 2,
      "cooldownMs": 600000
    },
    {
      "id": "bf-scenario-023",
      "event": "startup.workdayMorning",
      "text": "工作日開始。我先慢慢游進狀態。",
      "weight": 2,
      "cooldownMs": 600000
    },
    {
      "id": "bf-scenario-024",
      "event": "startup.workdayMorning",
      "text": "見面了。先挑一件能開始的小事吧。",
      "weight": 2,
      "cooldownMs": 600000
    },
    {
      "id": "bf-scenario-025",
      "event": "startup.dayOff",
      "text": "今天的安排。可以留一點空白。",
      "weight": 2,
      "cooldownMs": 600000
    },
    {
      "id": "bf-scenario-026",
      "event": "startup.dayOff",
      "text": "今天不用趕的話。我很樂意示範發呆。",
      "weight": 2,
      "cooldownMs": 600000
    },
    {
      "id": "bf-scenario-027",
      "event": "startup.dayOff",
      "text": "又見面了。休息也不用做得很用力。",
      "weight": 2,
      "cooldownMs": 600000
    },
    {
      "id": "bf-scenario-028",
      "event": "startup.dayOff",
      "text": "有空就待一會兒。沒有議程。",
      "weight": 2,
      "cooldownMs": 600000
    },
    {
      "id": "bf-scenario-029",
      "event": "schedule.halfHour",
      "text": "又半小時了。把肩膀從耳朵旁放下來。",
      "weight": 2,
      "cooldownMs": 600000
    },
    {
      "id": "bf-scenario-030",
      "event": "schedule.halfHour",
      "text": "時間走了半小時。你也可以動一下。",
      "weight": 2,
      "cooldownMs": 600000
    },
    {
      "id": "bf-scenario-031",
      "event": "schedule.lunchSoon",
      "text": "快到午飯時間。別讓肚子空等。",
      "weight": 2,
      "cooldownMs": 600000
    },
    {
      "id": "bf-scenario-032",
      "event": "schedule.lunchSoon",
      "text": "再忙也給午飯留個位置。我先替你惦記。",
      "weight": 2,
      "cooldownMs": 600000
