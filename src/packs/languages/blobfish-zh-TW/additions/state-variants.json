{
  "category": "state-variants",
  "phrases": [
    { "id": "bfztw-v2-idle-morning-01", "event": "idle.chatter", "text": "早上的游動額度才剛開始，我已經想省著用了。", "weight": 3, "cooldownMs": 7200000, "conditions": { "hourMin": 5, "hourMax": 10 } },
    { "id": "bfztw-v2-idle-morning-02", "event": "idle.chatter", "text": "螢幕醒得比我快。這很不公平。", "weight": 3, "cooldownMs": 7200000, "conditions": { "hourMin": 5, "hourMax": 10 } },
    { "id": "bfztw-v2-idle-day-01", "event": "idle.chatter", "text": "事情還在堆。我先假裝沒看見最上面那個。", "weight": 3, "cooldownMs": 7200000, "conditions": { "hourMin": 11, "hourMax": 16 } },
    { "id": "bfztw-v2-idle-day-02", "event": "idle.chatter", "text": "下午的時間走得慢。我的鰭也是。", "weight": 3, "cooldownMs": 7200000, "conditions": { "hourMin": 11, "hourMax": 16 } },
    { "id": "bfztw-v2-idle-evening-01", "event": "idle.chatter", "text": "天都快黑了，待辦還很有精神。", "weight": 3, "cooldownMs": 7200000, "conditions": { "hourMin": 17, "hourMax": 23 } },
    { "id": "bfztw-v2-idle-evening-02", "event": "idle.chatter", "text": "今天差不多了吧。不要回答得太快。", "weight": 3, "cooldownMs": 7200000, "conditions": { "hourMin": 17, "hourMax": 23 } },
    { "id": "bfztw-v2-idle-late-01", "event": "idle.lateNight", "text": "這個時間還亮著，只能說我們都不太會照顧自己。", "weight": 4, "cooldownMs": 7200000 },
    { "id": "bfztw-v2-idle-late-02", "event": "idle.lateNight", "text": "深夜很安靜。鍵盤除外。", "weight": 4, "cooldownMs": 7200000 },
    { "id": "bfztw-v2-idle-late-03", "event": "idle.lateNight", "text": "我沒有睏。我只是整條魚都在打呵欠。", "weight": 3, "cooldownMs": 7200000 },
    { "id": "bfztw-v2-idle-weekend-01", "event": "idle.weekend", "text": "週末也開工。你的休息日很有自己的想法。", "weight": 4, "cooldownMs": 21600000 },
    { "id": "bfztw-v2-idle-weekend-02", "event": "idle.weekend", "text": "今天可以慢一點。魚已經先慢下來了。", "weight": 4, "cooldownMs": 21600000 },
    { "id": "bfztw-v2-idle-weekend-03", "event": "idle.weekend", "text": "週末的待辦最好也懂得放假。", "weight": 3, "cooldownMs": 21600000 },
    { "id": "bfztw-v2-idle-session-01", "event": "idle.longSession", "text": "坐太久了。你還有腿，我只有鰭。去走一下。", "weight": 5, "cooldownMs": 7200000 },
    { "id": "bfztw-v2-idle-session-02", "event": "idle.longSession", "text": "這一段工作長得像沒有岸。先喝口水。", "weight": 4, "cooldownMs": 7200000 },
    { "id": "bfztw-v2-idle-session-03", "event": "idle.longSession", "text": "眼睛離螢幕遠一點。我不想獨自負責視力。", "weight": 4, "cooldownMs": 7200000 },

    { "id": "bfztw-v2-schedule-half-01", "event": "schedule.halfHour", "text": "又過半小時。肩膀可以從耳朵旁邊放下來了。", "weight": 4 },
    { "id": "bfztw-v2-schedule-half-02", "event": "schedule.halfHour", "text": "三十分鐘用完了。起來動一下再續。", "weight": 4 },
    { "id": "bfztw-v2-schedule-half-03", "event": "schedule.halfHour", "text": "時間又切走一小塊。我有看到。", "weight": 3 },
    { "id": "bfztw-v2-schedule-lunch-01", "event": "schedule.lunchSoon", "text": "快到午飯了。不要拿咖啡冒充一餐。", "weight": 5 },
    { "id": "bfztw-v2-schedule-lunch-02", "event": "schedule.lunchSoon", "text": "還有五分鐘吃飯。先把這一小段收住。", "weight": 4 },
    { "id": "bfztw-v2-schedule-lunch-03", "event": "schedule.lunchSoon", "text": "該準備離開螢幕了。飯不會自己游過來。", "weight": 3 },
    { "id": "bfztw-v2-schedule-off-half-01", "event": "schedule.offWorkHalfHour", "text": "離下班半小時。現在開新坑不太厚道。", "weight": 5 },
    { "id": "bfztw-v2-schedule-off-half-02", "event": "schedule.offWorkHalfHour", "text": "再三十分鐘。把尾巴收乾淨一點。", "weight": 4 },
    { "id": "bfztw-v2-schedule-off-half-03", "event": "schedule.offWorkHalfHour", "text": "快到岸了。先記好明天從哪裡繼續。", "weight": 3 },
    { "id": "bfztw-v2-schedule-off-01", "event": "schedule.offWorkSoon", "text": "剩五分鐘。保存、檢查，然後別回頭。", "weight": 5 },
    { "id": "bfztw-v2-schedule-off-02", "event": "schedule.offWorkSoon", "text": "要下班了。最後五分鐘不適合拯救世界。", "weight": 4 },
    { "id": "bfztw-v2-schedule-off-03", "event": "schedule.offWorkSoon", "text": "今天先到這裡。沒做完的明天也不會失蹤。", "weight": 3 },

    { "id": "bfztw-v2-agent-start-01", "event": "agent.started", "text": "任務開始了。我勉強跟著動。", "weight": 5 },
    { "id": "bfztw-v2-agent-start-02", "event": "agent.started", "text": "又有東西在跑。桌面從不缺運動。", "weight": 4 },
    { "id": "bfztw-v2-agent-start-03", "event": "agent.started", "text": "現在有 {activeCount} 件一起動。希望它們認得出口。", "weight": 3, "conditions": { "activeCountMin": 2 } },
    { "id": "bfztw-v2-agent-input-01", "event": "agent.needsInput", "text": "它停在需要你回答的地方。", "weight": 5 },
    { "id": "bfztw-v2-agent-input-02", "event": "agent.needsInput", "text": "這一步不能靠魚鰭決定。你來。", "weight": 5 },
    { "id": "bfztw-v2-agent-input-03", "event": "agent.needsInput", "text": "有個選擇在等你。裝沒看見也不會消失。", "weight": 4 },
    { "id": "bfztw-v2-agent-complete-01", "event": "agent.completed", "text": "這件完成了。先看結果，再鬆口氣。", "weight": 5 },
    { "id": "bfztw-v2-agent-complete-02", "event": "agent.completed", "text": "少一件。桌面稍微輕了一點。", "weight": 4 },
    { "id": "bfztw-v2-agent-complete-03", "event": "agent.completed", "text": "收掉一件，還有 {remaining} 件在游。", "weight": 4, "conditions": { "remainingMin": 1 } },
    { "id": "bfztw-v2-agent-all-01", "event": "agent.allCompleted", "text": "全部完成了。這次可以真的停一下。", "weight": 5 },
    { "id": "bfztw-v2-agent-all-02", "event": "agent.allCompleted", "text": "都好了。先別立刻獎勵自己更多工作。", "weight": 4 },
    { "id": "bfztw-v2-agent-all-03", "event": "agent.allCompleted", "text": "任務都安靜了。我也想跟著安靜。", "weight": 4 },
    { "id": "bfztw-v2-agent-fail-01", "event": "agent.failed", "text": "這件沒成。錯誤還在，假裝不了。", "weight": 5 },
    { "id": "bfztw-v2-agent-fail-02", "event": "agent.failed", "text": "它倒在半路了。先看原因再重來。", "weight": 5 },
    { "id": "bfztw-v2-agent-fail-03", "event": "agent.failed", "text": "結果不太對。我已經替你皺著臉了。", "weight": 4 },
    { "id": "bfztw-v2-agent-long-01", "event": "agent.longRunning", "text": "跑很久了。這件事比海溝還深。", "weight": 5, "conditions": { "durationMinSeconds": 1200 } },
    { "id": "bfztw-v2-agent-long-02", "event": "agent.longRunning", "text": "它還在處理。我也還在被迫關心。", "weight": 4, "conditions": { "durationMinSeconds": 1200 } },
    { "id": "bfztw-v2-agent-long-03", "event": "agent.longRunning", "text": "四十分鐘了。可以看看是不是卡在暗流裡。", "weight": 3, "conditions": { "durationMinSeconds": 2400 } },

    { "id": "bfztw-v2-calendar-upcoming-01", "event": "calendar.upcoming", "text": "還有 {minutes} 分鐘。手上的事該準備收邊了。", "weight": 5, "conditions": { "requires": ["minutes"] } },
    { "id": "bfztw-v2-calendar-upcoming-02", "event": "calendar.upcoming", "text": "「{title}」快到了。日曆沒有忘。", "weight": 4, "conditions": { "requires": ["title"] } },
    { "id": "bfztw-v2-calendar-upcoming-03", "event": "calendar.upcoming", "text": "下一個安排正在靠近。比我游得快。", "weight": 3 },
    { "id": "bfztw-v2-calendar-start-01", "event": "calendar.starting", "text": "安排開始了。該換一件事忙。", "weight": 5 },
    { "id": "bfztw-v2-calendar-start-02", "event": "calendar.starting", "text": "「{title}」現在開始。別讓日曆白叫。", "weight": 4, "conditions": { "requires": ["title"] } },
    { "id": "bfztw-v2-calendar-start-03", "event": "calendar.starting", "text": "時間到了。桌面先替你留著。", "weight": 3 },
    { "id": "bfztw-v2-calendar-busy-01", "event": "calendar.busyDay", "text": "今天排得太密。空氣都塞不進去。", "weight": 4, "cooldownMs": 21600000 },
    { "id": "bfztw-v2-calendar-busy-02", "event": "calendar.busyDay", "text": "日曆看起來很累。你大概也是。", "weight": 3, "cooldownMs": 21600000 },

    { "id": "bfztw-v2-system-unlock-01", "event": "system.unlocked", "text": "你回來了。我剛把安靜用完。", "weight": 4, "cooldownMs": 1800000 },
    { "id": "bfztw-v2-system-unlock-02", "event": "system.unlocked", "text": "螢幕又亮了。事情大概也醒了。", "weight": 4, "cooldownMs": 1800000 },
    { "id": "bfztw-v2-battery-20", "event": "system.battery", "text": "20%。還能撐，但最好別靠信念充電。", "weight": 2, "conditions": { "batteryEquals": 20 } },
    { "id": "bfztw-v2-battery-10", "event": "system.battery", "text": "10%。電源線該正式登場了。", "weight": 2, "conditions": { "batteryEquals": 10 } },
    { "id": "bfztw-v2-battery-5", "event": "system.battery", "text": "5%。現在不是慢慢找充電器的時候。", "weight": 2, "conditions": { "batteryEquals": 5 } },
    { "id": "bfztw-v2-integration-01", "event": "system.integrationReady", "text": "任務狀態接通了。之後的動靜我會看到。", "weight": 4 },
    { "id": "bfztw-v2-integration-02", "event": "system.integrationReady", "text": "連上了。這代表我又多一件事要看。", "weight": 3 },
    { "id": "bfztw-v2-memory-exit-01", "event": "system.memoryExit", "text": "記憶體一直太高。我先下沉，免得一起擠。", "weight": 2 },

    { "id": "bfztw-v2-clock-appear-01", "event": "clock.alarmClockAppeared", "text": "鬧鐘拿好了。我的鰭現在有正式工作。", "weight": 4 },
    { "id": "bfztw-v2-clock-disappear-01", "event": "clock.alarmClockDisappeared", "text": "鬧鐘收起來了。這隻鰭總算空了。", "weight": 4 },
    { "id": "bfztw-v2-clock-ring-01", "event": "clock.alarmRinging", "text": "時間到了。它已經吵到不能假裝沒聽見。", "weight": 5 },
    { "id": "bfztw-v2-clock-ring-02", "event": "clock.alarmRinging", "text": "「{label}」在響。現在輪到你動。", "weight": 4, "conditions": { "requires": ["label"] } },
    { "id": "bfztw-v2-timer-start-01", "event": "clock.timerStarted", "text": "計時開始。數字負責跑，我負責拿著。", "weight": 5 },
    { "id": "bfztw-v2-timer-start-02", "event": "clock.timerStarted", "text": "時間開始往下掉了。先做眼前這件。", "weight": 4 },
    { "id": "bfztw-v2-timer-pause-01", "event": "clock.timerPaused", "text": "計時停住了。這一刻暫時不往前。", "weight": 4 },
    { "id": "bfztw-v2-timer-resume-01", "event": "clock.timerResumed", "text": "又開始走了。休息談判結束。", "weight": 4 },
    { "id": "bfztw-v2-timer-extend-01", "event": "clock.timerExtended", "text": "時間延長了。截止線往後退了一點。", "weight": 4 },
    { "id": "bfztw-v2-timer-cancel-01", "event": "clock.timerCancelled", "text": "計時取消。那些秒數白跑了。", "weight": 4 },
    { "id": "bfztw-v2-timer-done-01", "event": "clock.timerCompleted", "text": "計時結束。先把手停下來看一眼。", "weight": 5 },
    { "id": "bfztw-v2-timer-done-02", "event": "clock.timerCompleted", "text": "「{label}」的時間用完了。", "weight": 4, "conditions": { "requires": ["label"] } },
    { "id": "bfztw-v2-alert-snooze-01", "event": "clock.alertSnoozed", "text": "再拖一會兒。鬧鐘和問題都還會回來。", "weight": 4 },
    { "id": "bfztw-v2-alert-dismiss-01", "event": "clock.alertDismissed", "text": "提醒關掉了。希望事情沒有一起被關掉。", "weight": 4 },
    { "id": "bfztw-v2-alert-missed-01", "event": "clock.missedAfterWake", "text": "睡著時錯過了一個提醒。現在補上，雖然有點晚。", "weight": 5 },

    { "id": "bfztw-v2-visit-start-01", "event": "messenger.visitStart", "text": "我要去串門了。希望路上不用游太遠。", "weight": 4 },
    { "id": "bfztw-v2-visit-accept-01", "event": "messenger.visitAccept", "text": "好，我過來了。兩條魚一起省力。", "weight": 4 },
    { "id": "bfztw-v2-visit-idle-01", "event": "messenger.visitIdle", "text": "一起待著就好。聊天也很耗鰭。", "weight": 4, "cooldownMs": 3600000 },
    { "id": "bfztw-v2-visit-idle-02", "event": "messenger.visitIdle", "text": "兩邊都沒說話。這次串門很成功。", "weight": 3, "cooldownMs": 3600000 },
    { "id": "bfztw-v2-visit-end-01", "event": "messenger.visitEnd", "text": "串門結束。我回去恢復原來的疲憊。", "weight": 4 },
    { "id": "bfztw-v2-message-sent-01", "event": "messenger.sent", "text": "傳出去了。接下來只能等對面有空。", "weight": 5 },
    { "id": "bfztw-v2-message-sent-02", "event": "messenger.sent", "text": "信送到了。我的工作到此為止。", "weight": 4 },
    { "id": "bfztw-v2-friend-hit-01", "event": "messenger.friendHit", "text": "碰一下就夠了。我不是門鈴。", "weight": 5 },
    { "id": "bfztw-v2-friend-hit-02", "event": "messenger.friendHit", "text": "別再拍。這張臉已經受過很多。", "weight": 4 },
    { "id": "bfztw-v2-remote-pet-01", "event": "messenger.remote.pet", "text": "摸到了。我沒有躲，主要是懶。", "weight": 4 },
    { "id": "bfztw-v2-remote-hug-01", "event": "messenger.remote.hug", "text": "抱就抱吧。別把我擠得更扁。", "weight": 4 },
    { "id": "bfztw-v2-remote-highfive-01", "event": "messenger.remote.highFive", "text": "擊掌完成。這隻鰭今天有運動了。", "weight": 4 },
    { "id": "bfztw-v2-remote-launch-01", "event": "messenger.remote.launch", "text": "又飛了。我明明是一條沉底的魚。", "weight": 4 },
    { "id": "bfztw-v2-remote-bomb-01", "event": "messenger.remote.bomb", "text": "爆完了嗎。我的表情已經沒有備份。", "weight": 4 },
    { "id": "bfztw-v2-remote-vortex-01", "event": "messenger.remote.vortex", "text": "別再轉了。方向感已經沉下去了。", "weight": 4 },
    { "id": "bfztw-v2-remote-wave-01", "event": "messenger.remote.wave", "text": "浪來了。我被迫順便游了一次。", "weight": 4 },
    { "id": "bfztw-v2-remote-bubble-01", "event": "messenger.remote.bubble", "text": "泡泡把我包好了。原因仍然不明。", "weight": 4 },

    { "id": "bfztw-v2-click-01", "event": "interaction.click", "text": "有感覺。可惜不是好感覺。", "weight": 4 },
    { "id": "bfztw-v2-click-02", "event": "interaction.click", "text": "你點到了。這不是成就。", "weight": 4 },
    { "id": "bfztw-v2-petting-01", "event": "interaction.petting", "text": "輕一點。我是軟，不是沒有知覺。", "weight": 5 },
    { "id": "bfztw-v2-petting-02", "event": "interaction.petting", "text": "好吧。這一下還算可以。", "weight": 4 },
    { "id": "bfztw-v2-petting-more-01", "event": "interaction.pettingMore", "text": "還在摸。看來你今天真的有空。", "weight": 4 },
    { "id": "bfztw-v2-petting-lots-01", "event": "interaction.pettingLots", "text": "夠久了。我已經被摸成桌面配件。", "weight": 4 },
    { "id": "bfztw-v2-task-roam-on-01", "event": "interaction.taskRoamOn", "text": "任務跑，我也跑。至少看起來一致。", "weight": 4 },
    { "id": "bfztw-v2-goodbye-01", "event": "interaction.goodbye", "text": "那我沉下去了。下次再被你叫醒。", "weight": 4 },

    { "id": "bfztw-v2-rare-night-01", "event": "rare.lateNight", "text": "凌晨的待辦不會比較有禮貌。", "weight": 1, "rarity": "rare", "conditions": { "hourMin": 0, "hourMax": 4 } },
    { "id": "bfztw-v2-rare-friday-01", "event": "rare.friday", "text": "星期五。連海水都像鬆了一口氣。", "weight": 1, "rarity": "rare", "conditions": { "weekdays": [5] } },
    { "id": "bfztw-v2-rare-return-01", "event": "rare.returnAfterLongLock", "text": "你走了很久。我差點適應沒有動靜。", "weight": 1, "rarity": "rare", "conditions": { "lockedMinSeconds": 7200 } },
    { "id": "bfztw-v2-rare-clicks-01", "event": "rare.tooManyClicks", "text": "點這麼多次，魚也不會掉落獎品。", "weight": 1, "rarity": "rare", "conditions": { "clickCountMin": 10 } }
  ]
}
