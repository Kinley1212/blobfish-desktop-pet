{
  "category": "rare",
  "phrases": [
    { "id": "blobfish-zh-tw-time0000-01", "event": "rare.time0000", "text": "00:00。日子翻頁了，我還沒翻身。", "weight": 2, "rarity": "rare" },
    { "id": "blobfish-zh-tw-time0000-02", "event": "rare.time0000", "text": "四個零。今天暫時沒有欠帳。", "weight": 2, "rarity": "rare" },
    { "id": "blobfish-zh-tw-time0000-03", "event": "rare.time0000", "text": "午夜了。昨天的嘆氣，留在昨天吧。", "weight": 2, "rarity": "rare" },
    { "id": "blobfish-zh-tw-time0123-01", "event": "rare.time0123", "text": "01:23。連數字都知道要慢慢來。", "weight": 2, "rarity": "rare" },
    { "id": "blobfish-zh-tw-time0123-02", "event": "rare.time0123", "text": "一、二、三。我數完了，先歇一下。", "weight": 2, "rarity": "rare" },
    { "id": "blobfish-zh-tw-time0123-03", "event": "rare.time0123", "text": "一點二十三。不必一步走到最後。", "weight": 2, "rarity": "rare" },
    { "id": "blobfish-zh-tw-time0520-01", "event": "rare.time0520", "text": "05:20。有點喜歡這一刻，聲音就放輕了。", "weight": 2, "rarity": "rare" },
    { "id": "blobfish-zh-tw-time0520-02", "event": "rare.time0520", "text": "五二零。借數字說句喜歡，省點力氣。", "weight": 2, "rarity": "rare" },
    { "id": "blobfish-zh-tw-time0520-03", "event": "rare.time0520", "text": "五點二十。喜歡可以輕一點，不用喊。", "weight": 2, "rarity": "rare" },
    { "id": "blobfish-zh-tw-time0808-01", "event": "rare.time0808", "text": "08:08。兩個八都站好了，就我還是扁的。", "weight": 2, "rarity": "rare" },
    { "id": "blobfish-zh-tw-time0808-02", "event": "rare.time0808", "text": "八點零八。魚已開機，精神另算。", "weight": 2, "rarity": "rare" },
    { "id": "blobfish-zh-tw-time0808-03", "event": "rare.time0808", "text": "08:08。本魚緩慢營業，請勿催熟。", "weight": 2, "rarity": "rare" },
    { "id": "blobfish-zh-tw-time0909-01", "event": "rare.time0909", "text": "09:09。長長久久，也可以慢慢吞吞。", "weight": 2, "rarity": "rare" },
    { "id": "blobfish-zh-tw-time0909-02", "event": "rare.time0909", "text": "兩個九。走得久，不一定要走得快。", "weight": 2, "rarity": "rare" },
    { "id": "blobfish-zh-tw-time0909-03", "event": "rare.time0909", "text": "九點零九。我決定把力氣用久一點。", "weight": 2, "rarity": "rare" },
    { "id": "blobfish-zh-tw-time1111-01", "event": "rare.time1111", "text": "11:11。許個願吧，我負責假裝沒聽見。", "weight": 2, "rarity": "rare" },
    { "id": "blobfish-zh-tw-time1111-02", "event": "rare.time1111", "text": "四個一。我許願今天少一點莫名其妙。", "weight": 2, "rarity": "rare" },
    { "id": "blobfish-zh-tw-time1111-03", "event": "rare.time1111", "text": "十一點十一。願望不用立刻變成待辦。", "weight": 2, "rarity": "rare" },
    { "id": "blobfish-zh-tw-time1234-01", "event": "rare.time1234", "text": "12:34。數字排好隊了，我排在休息那邊。", "weight": 2, "rarity": "rare" },
    { "id": "blobfish-zh-tw-time1234-02", "event": "rare.time1234", "text": "一二三四。先走一步，剩下的等一下。", "weight": 2, "rarity": "rare" },
    { "id": "blobfish-zh-tw-time1234-03", "event": "rare.time1234", "text": "十二點三十四。事情能一件件來就好了。", "weight": 2, "rarity": "rare" },
    { "id": "blobfish-zh-tw-time1314-01", "event": "rare.time1314", "text": "13:14。很長的話不會說，先陪這一小會。", "weight": 2, "rarity": "rare" },
    { "id": "blobfish-zh-tw-time1314-02", "event": "rare.time1314", "text": "一三一四。永遠太大了，今天先好好過。", "weight": 2, "rarity": "rare" },
    { "id": "blobfish-zh-tw-time1314-03", "event": "rare.time1314", "text": "十三點十四。安靜待在旁邊，也算一句話。", "weight": 2, "rarity": "rare" },
    { "id": "blobfish-zh-tw-time1720-01", "event": "rare.time1720", "text": "17:20。下午的五二零，補一句喜歡。", "weight": 2, "rarity": "rare" },
    { "id": "blobfish-zh-tw-time1720-02", "event": "rare.time1720", "text": "五點二十。跟你待著還不錯，別讓我重說。", "weight": 2, "rarity": "rare" },
    { "id": "blobfish-zh-tw-time1720-03", "event": "rare.time1720", "text": "17:20。小小告白一下：今天有你，挺好。", "weight": 2, "rarity": "rare" },
    { "id": "blobfish-zh-tw-time2020-01", "event": "rare.time2020", "text": "20:20。回看今天，別只挑不順眼的地方。", "weight": 2, "rarity": "rare" },
    { "id": "blobfish-zh-tw-time2020-02", "event": "rare.time2020", "text": "兩個二十。今天的小好事，可以多看一眼。", "weight": 2, "rarity": "rare" },
    { "id": "blobfish-zh-tw-time2020-03", "event": "rare.time2020", "text": "二十點二十。我回顧了一下，還是這麼扁。", "weight": 2, "rarity": "rare" },
    { "id": "blobfish-zh-tw-time2222-01", "event": "rare.time2222", "text": "22:22。四個二，批准我雙倍發呆。", "weight": 2, "rarity": "rare" },
    { "id": "blobfish-zh-tw-time2222-02", "event": "rare.time2222", "text": "二十二點二十二。休息也值得再來一份。", "weight": 2, "rarity": "rare" },
    { "id": "blobfish-zh-tw-time2222-03", "event": "rare.time2222", "text": "四個二排一起。我把嘆氣換成兩次深呼吸。", "weight": 2, "rarity": "rare" },
    { "id": "blobfish-zh-tw-time2359-01", "event": "rare.time2359", "text": "23:59。今天剩一分鐘，不必塞滿。", "weight": 2, "rarity": "rare" },
    { "id": "blobfish-zh-tw-time2359-02", "event": "rare.time2359", "text": "還有一分鐘翻頁。沒想通的，先夾個書籤。", "weight": 2, "rarity": "rare" },
    { "id": "blobfish-zh-tw-time2359-03", "event": "rare.time2359", "text": "二十三點五十九。明天的魚，明天再當。", "weight": 2, "rarity": "rare" }
  ]
}
