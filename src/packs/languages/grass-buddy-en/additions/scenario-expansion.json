      "cooldownMs": 3600000,
      "conditions": {
        "hourMin": 11,
        "hourMax": 16
      }
    },
    {
      "id": "gb-scenario-en-006",
      "event": "idle.chatter",
      "text": "I thought of something to say. Put it back.",
      "weight": 2,
      "cooldownMs": 3600000,
      "conditions": {
        "hourMin": 11,
        "hourMax": 16
      }
    },
    {
      "id": "gb-scenario-en-007",
      "event": "idle.chatter",
      "text": "It is getting late. Your shoulders can still relax.",
