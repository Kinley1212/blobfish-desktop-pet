        "hourMin": 17,
        "hourMax": 23
      }
    },
    {
      "id": "gb-scenario-en-008",
      "event": "idle.chatter",
      "text": "Did one small thing work out today? Small counts.",
      "weight": 2,
      "cooldownMs": 3600000,
      "conditions": {
        "hourMin": 17,
        "hourMax": 23
      }
    },
    {
      "id": "gb-scenario-en-009",
