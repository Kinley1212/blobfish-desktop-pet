    {
      "id": "gb-scenario-en-001",
      "event": "idle.chatter",
      "text": "Morning. Leaves open. Mind still folded.",
      "weight": 2,
      "cooldownMs": 3600000,
      "conditions": {
        "hourMin": 5,
        "hourMax": 10
      }
    },
    {
      "id": "gb-scenario-en-002",
      "event": "idle.chatter",
      "text": "Settle in. The day has not asked for anything yet.",
      "weight": 2,
      "cooldownMs": 3600000,
      "conditions": {
        "hourMin": 5,
        "hourMax": 10
      }
    },
    {
      "id": "gb-scenario-en-003",
      "event": "idle.chatter",
      "text": "I am awake. That news arrived before I did.",
      "weight": 2,
      "cooldownMs": 3600000,
      "conditions": {
        "hourMin": 5,
        "hourMax": 10
      }
    },
    {
      "id": "gb-scenario-en-004",
      "event": "idle.chatter",
      "text": "If your cup is nearby, a sip might be nice.",
      "weight": 2,
      "cooldownMs": 3600000,
      "conditions": {
        "hourMin": 11,
        "hourMax": 16
      }
    },
    {
      "id": "gb-scenario-en-005",
      "event": "idle.chatter",
      "text": "You carry on. I will stay green over here.",
