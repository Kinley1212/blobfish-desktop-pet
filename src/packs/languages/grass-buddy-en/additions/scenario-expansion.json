      "weight": 2,
      "cooldownMs": 3600000,
      "conditions": {
        "hourMin": 0,
        "hourMax": 4
      }
    },
    {
      "id": "gb-scenario-en-010",
      "event": "idle.chatter",
      "text": "It is quiet at night. Your eyes can rest a little too.",
      "weight": 2,
      "cooldownMs": 3600000,
      "conditions": {
        "hourMin": 0,
        "hourMax": 4
      }
    },
    {
      "id": "gb-scenario-en-011",
      "event": "idle.chatter",
