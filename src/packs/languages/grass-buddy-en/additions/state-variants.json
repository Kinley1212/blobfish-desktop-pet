{
  "category": "state-variants",
  "phrases": [
    { "id": "gben-v2-idle-morning-01", "event": "idle.chatter", "text": "Morning light arrived. I will catch it slowly.", "weight": 3, "cooldownMs": 7200000, "conditions": { "hourMin": 5, "hourMax": 10 } },
    { "id": "gben-v2-idle-morning-02", "event": "idle.chatter", "text": "The desktop is awake. My leaves are loading.", "weight": 3, "cooldownMs": 7200000, "conditions": { "hourMin": 5, "hourMax": 10 } },
    { "id": "gben-v2-idle-day-01", "event": "idle.chatter", "text": "Work is piling up. Like soil, but not good soil.", "weight": 3, "cooldownMs": 7200000, "conditions": { "hourMin": 11, "hourMax": 16 } },
    { "id": "gben-v2-idle-day-02", "event": "idle.chatter", "text": "The afternoon breeze is slow. Finish one thing.", "weight": 3, "cooldownMs": 7200000, "conditions": { "hourMin": 11, "hourMax": 16 } },
    { "id": "gben-v2-idle-evening-01", "event": "idle.chatter", "text": "The light is fading. The tasks have not dropped their leaves.", "weight": 3, "cooldownMs": 7200000, "conditions": { "hourMin": 17, "hourMax": 23 } },
    { "id": "gben-v2-idle-evening-02", "event": "idle.chatter", "text": "We can put down roots for today. Probably.", "weight": 3, "cooldownMs": 7200000, "conditions": { "hourMin": 17, "hourMax": 23 } },
    { "id": "gben-v2-idle-late-01", "event": "idle.lateNight", "text": "There is no sun at this hour. You are still glowing.", "weight": 4, "cooldownMs": 7200000 },
    { "id": "gben-v2-idle-late-02", "event": "idle.lateNight", "text": "The night breeze is quiet. The keyboard is not.", "weight": 4, "cooldownMs": 7200000 },
    { "id": "gben-v2-idle-late-03", "event": "idle.lateNight", "text": "The leaves are closed. Habit remains awake.", "weight": 3, "cooldownMs": 7200000 },
    { "id": "gben-v2-idle-weekend-01", "event": "idle.weekend", "text": "Still working on the weekend. The roots have no comment.", "weight": 4, "cooldownMs": 21600000 },
    { "id": "gben-v2-idle-weekend-02", "event": "idle.weekend", "text": "We can grow more slowly today.", "weight": 4, "cooldownMs": 21600000 },
    { "id": "gben-v2-idle-weekend-03", "event": "idle.weekend", "text": "A day off does not need every patch planted.", "weight": 3, "cooldownMs": 21600000 },
    { "id": "gben-v2-idle-session-01", "event": "idle.longSession", "text": "You sat too long. The roots may misunderstand. Walk around.", "weight": 5, "cooldownMs": 7200000 },
    { "id": "gben-v2-idle-session-02", "event": "idle.longSession", "text": "This has been a long stretch. Drink water.", "weight": 4, "cooldownMs": 7200000 },
    { "id": "gben-v2-idle-session-03", "event": "idle.longSession", "text": "Focus your eyes farther away. Leaves should not stare either.", "weight": 4, "cooldownMs": 7200000 },

    { "id": "gben-v2-schedule-half-01", "event": "schedule.halfHour", "text": "Another half hour. Loosen your shoulders.", "weight": 4 },
    { "id": "gben-v2-schedule-half-02", "event": "schedule.halfHour", "text": "Thirty minutes grew past. Move around.", "weight": 4 },
    { "id": "gben-v2-schedule-half-03", "event": "schedule.halfHour", "text": "Time dropped a leaf. Continue.", "weight": 3 },
    { "id": "gben-v2-schedule-lunch-01", "event": "schedule.lunchSoon", "text": "Lunch soon. Coffee is not soil.", "weight": 5 },
    { "id": "gben-v2-schedule-lunch-02", "event": "schedule.lunchSoon", "text": "Five minutes left. Finish this branch.", "weight": 4 },
    { "id": "gben-v2-schedule-lunch-03", "event": "schedule.lunchSoon", "text": "Time to leave the screen and eat.", "weight": 3 },
    { "id": "gben-v2-schedule-off-half-01", "event": "schedule.offWorkHalfHour", "text": "Half an hour left. Do not plant a new hole.", "weight": 5 },
    { "id": "gben-v2-schedule-off-half-02", "event": "schedule.offWorkHalfHour", "text": "Thirty minutes. Start folding the leaves.", "weight": 4 },
    { "id": "gben-v2-schedule-off-half-03", "event": "schedule.offWorkHalfHour", "text": "Nearly at the edge. Note where tomorrow begins.", "weight": 3 },
    { "id": "gben-v2-schedule-off-01", "event": "schedule.offWorkSoon", "text": "Five minutes. Save, check, stop.", "weight": 5 },
    { "id": "gben-v2-schedule-off-02", "event": "schedule.offWorkSoon", "text": "Almost done. Do not grow a new branch now.", "weight": 4 },
    { "id": "gben-v2-schedule-off-03", "event": "schedule.offWorkSoon", "text": "Enough for today. It can keep growing tomorrow.", "weight": 3 },

    { "id": "gben-v2-agent-start-01", "event": "agent.started", "text": "A task started. Grow forward.", "weight": 5 },
    { "id": "gben-v2-agent-start-02", "event": "agent.started", "text": "Another thing is moving. The wind arrived.", "weight": 4 },
    { "id": "gben-v2-agent-start-03", "event": "agent.started", "text": "Now {activeCount} tasks are growing. Do not crowd.", "weight": 3, "conditions": { "activeCountMin": 2 } },
    { "id": "gben-v2-agent-input-01", "event": "agent.needsInput", "text": "It stopped where your answer is needed.", "weight": 5 },
    { "id": "gben-v2-agent-input-02", "event": "agent.needsInput", "text": "You must decide this step. Roots cannot sign.", "weight": 5 },
    { "id": "gben-v2-agent-input-03", "event": "agent.needsInput", "text": "A choice is waiting. Have a look.", "weight": 4 },
    { "id": "gben-v2-agent-complete-01", "event": "agent.completed", "text": "That one finished growing. Check the result.", "weight": 5 },
    { "id": "gben-v2-agent-complete-02", "event": "agent.completed", "text": "One branch less. The desktop is wider.", "weight": 4 },
    { "id": "gben-v2-agent-complete-03", "event": "agent.completed", "text": "One task stored. {remaining} are still growing.", "weight": 4, "conditions": { "remainingMin": 1 } },
    { "id": "gben-v2-agent-all-01", "event": "agent.allCompleted", "text": "Everything grew to completion. Stand still now.", "weight": 5 },
    { "id": "gben-v2-agent-all-02", "event": "agent.allCompleted", "text": "All done. Do not sow the next batch immediately.", "weight": 4 },
    { "id": "gben-v2-agent-all-03", "event": "agent.allCompleted", "text": "The tasks are quiet. Let the wind stop.", "weight": 4 },
    { "id": "gben-v2-agent-fail-01", "event": "agent.failed", "text": "That branch did not grow well. The error remains.", "weight": 5 },
    { "id": "gben-v2-agent-fail-02", "event": "agent.failed", "text": "It broke midway. Find the reason first.", "weight": 5 },
    { "id": "gben-v2-agent-fail-03", "event": "agent.failed", "text": "The result is wrong. Check the soil again.", "weight": 4 },
    { "id": "gben-v2-agent-long-01", "event": "agent.longRunning", "text": "It has run a while. These roots are deep.", "weight": 5, "conditions": { "durationMinSeconds": 1200 } },
    { "id": "gben-v2-agent-long-02", "event": "agent.longRunning", "text": "It is still processing. The leaf tip still moves.", "weight": 4, "conditions": { "durationMinSeconds": 1200 } },
    { "id": "gben-v2-agent-long-03", "event": "agent.longRunning", "text": "Forty minutes. It may be tangled in a vine.", "weight": 3, "conditions": { "durationMinSeconds": 2400 } },
    { "id": "gben-v2-agent-ended-01", "event": "agent.ended", "text": "That run stopped. See what grew.", "weight": 5 },
    { "id": "gben-v2-agent-ended-02", "event": "agent.ended", "text": "It ended. The wind became smaller.", "weight": 4 },
    { "id": "gben-v2-agent-all-ended-01", "event": "agent.allEnded", "text": "Everything stopped. Results are separate.", "weight": 5 },
    { "id": "gben-v2-agent-all-ended-02", "event": "agent.allEnded", "text": "No tasks are moving. Leave some space.", "weight": 4 },

    { "id": "gben-v2-calendar-upcoming-01", "event": "calendar.upcoming", "text": "{minutes} minutes left. Finish the branch in hand.", "weight": 5, "conditions": { "requires": ["minutes"] } },
    { "id": "gben-v2-calendar-upcoming-02", "event": "calendar.upcoming", "text": "“{title}” is soon. The calendar remembers.", "weight": 4, "conditions": { "requires": ["title"] } },
    { "id": "gben-v2-calendar-upcoming-03", "event": "calendar.upcoming", "text": "The next appointment is close. Prepare to turn.", "weight": 3 },
    { "id": "gben-v2-calendar-start-01", "event": "calendar.starting", "text": "The appointment started. Move to another patch.", "weight": 5 },
    { "id": "gben-v2-calendar-start-02", "event": "calendar.starting", "text": "“{title}” starts now.", "weight": 4, "conditions": { "requires": ["title"] } },
    { "id": "gben-v2-calendar-start-03", "event": "calendar.starting", "text": "It is time. The desktop stays here.", "weight": 3 },
    { "id": "gben-v2-calendar-busy-01", "event": "calendar.busyDay", "text": "Today is packed. There is little open ground.", "weight": 4, "cooldownMs": 21600000 },
    { "id": "gben-v2-calendar-busy-02", "event": "calendar.busyDay", "text": "The calendar grew too tightly. Leave some breeze.", "weight": 3, "cooldownMs": 21600000 },
    { "id": "gben-v2-calendar-free-01", "event": "calendar.freeGap", "text": "There is an open patch ahead. Leave it open.", "weight": 4, "cooldownMs": 10800000 },
    { "id": "gben-v2-calendar-free-02", "event": "calendar.freeGap", "text": "Nothing scheduled for now. Let the breeze in.", "weight": 3, "cooldownMs": 10800000 },

    { "id": "gben-v2-system-unlock-01", "event": "system.unlocked", "text": "You are back. There was no wind.", "weight": 4, "cooldownMs": 1800000 },
    { "id": "gben-v2-system-unlock-02", "event": "system.unlocked", "text": "The screen lit up. The leaves opened.", "weight": 4, "cooldownMs": 1800000 },
    { "id": "gben-v2-system-error-01", "event": "system.error", "text": "A root broke here. This is not quiet.", "weight": 5, "cooldownMs": 300000 },
    { "id": "gben-v2-system-error-02", "event": "system.error", "text": "It grew in the wrong direction. Look.", "weight": 4, "cooldownMs": 300000 },
    { "id": "gben-v2-battery-20", "event": "system.battery", "text": "Twenty percent. Start finding power.", "weight": 2, "conditions": { "batteryEquals": 20 } },
    { "id": "gben-v2-battery-10", "event": "system.battery", "text": "Ten percent. The power cable should emerge.", "weight": 2, "conditions": { "batteryEquals": 10 } },
    { "id": "gben-v2-battery-5", "event": "system.battery", "text": "Five percent. Get the charger now.", "weight": 2, "conditions": { "batteryEquals": 5 } },
    { "id": "gben-v2-integration-01", "event": "system.integrationReady", "text": "Task status is connected. Movement will come through.", "weight": 4 },
    { "id": "gben-v2-integration-02", "event": "system.integrationReady", "text": "Connected. The breeze comes from there.", "weight": 3 },
    { "id": "gben-v2-memory-exit-01", "event": "system.memoryExit", "text": "Memory stayed too high. I will close my leaves.", "weight": 2 },

    { "id": "gben-v2-clock-appear-01", "event": "clock.alarmClockAppeared", "text": "I have the clock. This leaf has work.", "weight": 4 },
    { "id": "gben-v2-clock-disappear-01", "event": "clock.alarmClockDisappeared", "text": "The clock is away. The leaf tip is free.", "weight": 4 },
    { "id": "gben-v2-clock-ring-01", "event": "clock.alarmRinging", "text": "Time is up. The sound has grown.", "weight": 5 },
    { "id": "gben-v2-clock-ring-02", "event": "clock.alarmRinging", "text": "“{label}” is ringing. Move now.", "weight": 4, "conditions": { "requires": ["label"] } },
    { "id": "gben-v2-timer-start-01", "event": "clock.timerStarted", "text": "Timer started. The numbers grow downward.", "weight": 5 },
    { "id": "gben-v2-timer-start-02", "event": "clock.timerStarted", "text": "Time is moving. Do the thing in front of you.", "weight": 4 },
    { "id": "gben-v2-timer-pause-01", "event": "clock.timerPaused", "text": "Timer paused. The breeze can pause too.", "weight": 4 },
    { "id": "gben-v2-timer-resume-01", "event": "clock.timerResumed", "text": "Time is moving again. Continue.", "weight": 4 },
    { "id": "gben-v2-timer-extend-01", "event": "clock.timerExtended", "text": "Time extended. The edge moved back.", "weight": 4 },
    { "id": "gben-v2-timer-cancel-01", "event": "clock.timerCancelled", "text": "Timer cancelled. The numbers can stop growing.", "weight": 4 },
    { "id": "gben-v2-timer-done-01", "event": "clock.timerCompleted", "text": "Timer finished. Stop and look up.", "weight": 5 },
    { "id": "gben-v2-timer-done-02", "event": "clock.timerCompleted", "text": "Time is up for “{label}.”", "weight": 4, "conditions": { "requires": ["label"] } },
    { "id": "gben-v2-alert-snooze-01", "event": "clock.alertSnoozed", "text": "Wait a little. The reminder will sprout again.", "weight": 4 },
    { "id": "gben-v2-alert-dismiss-01", "event": "clock.alertDismissed", "text": "Reminder closed. Do not close the task with it.", "weight": 4 },
    { "id": "gben-v2-alert-missed-01", "event": "clock.missedAfterWake", "text": "A reminder passed during sleep. Here it is now.", "weight": 5 },

    { "id": "gben-v2-visit-start-01", "event": "messenger.visitStart", "text": "Going visiting. The roots stay here.", "weight": 4 },
    { "id": "gben-v2-visit-accept-01", "event": "messenger.visitAccept", "text": "All right. I will stand over there.", "weight": 4 },
    { "id": "gben-v2-visit-idle-01", "event": "messenger.visitIdle", "text": "Standing together is enough. The breeze can talk.", "weight": 4, "cooldownMs": 3600000 },
    { "id": "gben-v2-visit-idle-02", "event": "messenger.visitIdle", "text": "Both sides are quiet. This still counts as visiting.", "weight": 3, "cooldownMs": 3600000 },
    { "id": "gben-v2-visit-end-01", "event": "messenger.visitEnd", "text": "Visit over. Time to root again.", "weight": 4 },
    { "id": "gben-v2-message-sent-01", "event": "messenger.sent", "text": "Sent. Wait for a breeze back.", "weight": 5 },
    { "id": "gben-v2-message-sent-02", "event": "messenger.sent", "text": "Message delivered. The leaves can lower.", "weight": 4 },
    { "id": "gben-v2-friend-hit-01", "event": "messenger.friendHit", "text": "One tap is enough. I am not a doorbell.", "weight": 5 },
    { "id": "gben-v2-friend-hit-02", "event": "messenger.friendHit", "text": "Stop swatting. The leaf tips get untidy.", "weight": 4 },
    { "id": "gben-v2-remote-pet-01", "event": "messenger.remote.pet", "text": "I felt that. Like a small breeze.", "weight": 4 },
    { "id": "gben-v2-remote-hug-01", "event": "messenger.remote.hug", "text": "Hug received. Mind the roots.", "weight": 4 },
    { "id": "gben-v2-remote-highfive-01", "event": "messenger.remote.highFive", "text": "High five complete. A leaf made a sound.", "weight": 4 },
    { "id": "gben-v2-remote-launch-01", "event": "messenger.remote.launch", "text": "Airborne. The roots did not follow.", "weight": 4 },
    { "id": "gben-v2-remote-bomb-01", "event": "messenger.remote.bomb", "text": "Explosion over. There is dust on the leaves.", "weight": 4 },
    { "id": "gben-v2-remote-vortex-01", "event": "messenger.remote.vortex", "text": "Too much spinning. The tips lost direction.", "weight": 4 },
    { "id": "gben-v2-remote-wave-01", "event": "messenger.remote.wave", "text": "A wave. That is a lot of water.", "weight": 4 },
    { "id": "gben-v2-remote-bubble-01", "event": "messenger.remote.bubble", "text": "The bubble covered the leaves. Stay still.", "weight": 4 },

    { "id": "gben-v2-click-01", "event": "interaction.click", "text": "I felt that. The leaf tip remembers.", "weight": 4 },
    { "id": "gben-v2-click-02", "event": "interaction.click", "text": "You clicked. No flowers here.", "weight": 4 },
    { "id": "gben-v2-menu-01", "event": "interaction.menuOpen", "text": "The menu opened. I will stand still.", "weight": 4 },
    { "id": "gben-v2-petting-01", "event": "interaction.petting", "text": "Gently. Leaves have a direction.", "weight": 5 },
    { "id": "gben-v2-petting-02", "event": "interaction.petting", "text": "That was fine. Like wind.", "weight": 4 },
    { "id": "gben-v2-petting-more-01", "event": "interaction.pettingMore", "text": "Still petting. The leaves will stay open.", "weight": 4 },
    { "id": "gben-v2-petting-lots-01", "event": "interaction.pettingLots", "text": "That is long enough. The leaves are aligned.", "weight": 4 },
    { "id": "gben-v2-idle-roam-on-01", "event": "interaction.idleRoamOn", "text": "Walking without tasks. Fold the roots first.", "weight": 4 },
    { "id": "gben-v2-task-roam-on-01", "event": "interaction.taskRoamOn", "text": "The task moves. I walk. Same wind.", "weight": 4 },
    { "id": "gben-v2-goodbye-01", "event": "interaction.goodbye", "text": "I will fold the leaves. Open them next time.", "weight": 4 },

    { "id": "gben-v2-rare-night-01", "event": "rare.lateNight", "text": "Tasks after midnight get no sunlight either.", "weight": 1, "rarity": "rare", "conditions": { "hourMin": 0, "hourMax": 4 } },
    { "id": "gben-v2-rare-friday-01", "event": "rare.friday", "text": "Friday. The breeze loosened slightly.", "weight": 1, "rarity": "rare", "conditions": { "weekdays": [5] } },
    { "id": "gben-v2-rare-finished-01", "event": "rare.allCompletedFollowUp", "text": "Everything grew. The open ground remains.", "weight": 1, "rarity": "rare" },
    { "id": "gben-v2-rare-return-01", "event": "rare.returnAfterLongLock", "text": "You were gone a long time. The light changed once.", "weight": 1, "rarity": "rare", "conditions": { "lockedMinSeconds": 7200 } },
    { "id": "gben-v2-rare-clicks-01", "event": "rare.tooManyClicks", "text": "Many clicks. It still grows the same grass.", "weight": 1, "rarity": "rare", "conditions": { "clickCountMin": 10 } }
  ]
}
